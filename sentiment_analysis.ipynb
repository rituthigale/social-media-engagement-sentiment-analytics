1. Project Title
# Social Media Engagement & Sentiment Analytics
2. Import Required Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import nltk
from nltk.sentiment import SentimentIntensityAnalyzer
3. Download NLTK Resources
nltk.download('vader_lexicon')
4. Load Dataset
df = pd.read_csv("social_media_mentions.csv")
df.head()
5. Dataset Exploration (EDA)
Check Dataset Shape
df.shape
Dataset Information
df.info()
Statistical Summary
df.describe()
Missing Values
df.isnull().sum()
6. Data Cleaning
df.dropna(inplace=True)
7. Sentiment Analysis

Create VADER Analyzer:

sia = SentimentIntensityAnalyzer()

Generate Scores:

df['Sentiment_Score'] = df['Comment'].apply(
    lambda x: sia.polarity_scores(str(x))['compound']
)

Create Labels:

def sentiment_label(score):
    if score >= 0.05:
        return 'Positive'
    elif score <= -0.05:
        return 'Negative'
    else:
        return 'Neutral'

df['Sentiment'] = df['Sentiment_Score'].apply(sentiment_label)
8. Engagement Rate Calculation
df['Engagement_Rate'] = (
    (df['Likes'] + df['Shares'])
    / df['Followers']
) * 100
9. Visualizations
Sentiment Distribution
sns.countplot(x='Sentiment', data=df)
plt.title("Sentiment Distribution")
plt.show()
Brand-wise Sentiment
pd.crosstab(df['Brand'], df['Sentiment']).plot(kind='bar')
plt.title("Brand-wise Sentiment")
plt.show()
Platform-wise Sentiment
pd.crosstab(df['Platform'], df['Sentiment']).plot(kind='bar')
plt.title("Platform-wise Sentiment")
plt.show()
Engagement Rate by Platform
df.groupby('Platform')['Engagement_Rate'].mean().plot(kind='bar')
plt.title("Engagement Rate by Platform")
plt.show()
Likes by Brand
df.groupby('Brand')['Likes'].sum().plot(kind='bar')
plt.title("Likes by Brand")
plt.show()
10. Business Insights
print("Total Mentions:", len(df))
print(df['Sentiment'].value_counts())
print("Average Engagement Rate:", df['Engagement_Rate'].mean())
11. Save Processed Dataset
df.to_csv(
    "processed_social_media_data.csv",
    index=False
)
