import pandas as pd
import nltk
import matplotlib.pyplot as plt
import seaborn as sns
from nltk.sentiment import SentimentIntensityAnalyzer

# Download VADER Lexicon

nltk.download('vader_lexicon')

# Load Dataset

df = pd.read_csv('social_media_mentions.csv')

# Display First Records

print(df.head())

# Create Sentiment Analyzer

sia = SentimentIntensityAnalyzer()

# Sentiment Score

df['Sentiment_Score'] = df['Comment'].apply(
lambda x: sia.polarity_scores(str(x))['compound']
)

# Sentiment Label Function

def sentiment_label(score):
if score >= 0.05:
return 'Positive'
elif score <= -0.05:
return 'Negative'
else:
return 'Neutral'

# Apply Labels

df['Sentiment'] = df['Sentiment_Score'].apply(sentiment_label)

# Engagement Rate Calculation

df['Engagement_Rate'] = (
(df['Likes'] + df['Shares']) /
df['Followers']
) * 100

# Save Processed Data

df.to_csv(
'processed_social_media_data.csv',
index=False
)

# Sentiment Distribution

plt.figure(figsize=(6,4))
sns.countplot(x='Sentiment', data=df)
plt.title('Sentiment Distribution')
plt.show()

# Brand-wise Sentiment

brand_sentiment = pd.crosstab(
df['Brand'],
df['Sentiment']
)

brand_sentiment.plot(
kind='bar',
figsize=(8,5)
)

plt.title('Brand-wise Sentiment')
plt.show()

# Platform Engagement

platform_engagement = df.groupby(
'Platform'
)['Engagement_Rate'].mean()

platform_engagement.plot(
kind='bar',
figsize=(8,5)
)

plt.title('Average Engagement Rate by Platform')
plt.show()

print("Project Completed Successfully")
